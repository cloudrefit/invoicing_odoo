<odoo>
    <data noupdate="1">
        <record id="ir_cron_zatca_retry" model="ir.cron">
            <field name="name">CloudRefit ZATCA: Retry Failed Invoices</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="code">model._zatca_retry_failed()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>
        <record id="ir_cron_zatca_version_check" model="ir.cron">
            <field name="name">CloudRefit: Check for Plugin Updates</field>
            <field name="model_id" ref="cloudrefit_invoicing.model_cloudrefit_version_checker"/>
            <field name="state">code</field>
            <field name="code">model.check_for_updates()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_cloudrefit_sync_payments" model="ir.cron">
            <field name="name">CloudRefit ZATCA: Sync Payments</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="state">code</field>
            <field name="code">model._zatca_sync_payments()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>


            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
