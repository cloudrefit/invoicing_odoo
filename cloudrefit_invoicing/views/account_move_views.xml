<odoo>
    <!-- RTL: Verified for Arabic locale compatibility -->

    <record id="view_move_form_zatca" model="ir.ui.view">
        <field name="name">account.move.form.zatca</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="is_zatca_push_allowed" invisible="1"/>
                <field name="is_zatca_sandbox_allowed" invisible="1"/>
                <field name="zatca_exec_mode" invisible="1"/>
                <field name="zatca_signed_xml" invisible="1"/>
                <field name="zatca_job_status" invisible="1"/>
                <field name="zatca_15_days_warning" invisible="1"/>
                
                <field name="cloudrefit_effective_severity" invisible="1"/>
                <field name="cloudrefit_show_banner" invisible="1"/>
                <field name="cloudrefit_banner_dismissible" invisible="1"/>
                <field name="cloudrefit_show_push_modal" invisible="1"/>
                <field name="cloudrefit_push_blocked" invisible="1"/>
                
                <!-- Live Push Button -->
                <button name="action_zatca_sign"
                        string="Push to ZATCA"
                        type="object"
                        class="oe_highlight"
                        icon="fa-cloud-upload"
                        confirm="This invoice will be permanently reported to ZATCA Live. Continue?"
                        invisible="not is_zatca_push_allowed or move_type not in ('out_invoice', 'out_refund') or cloudrefit_push_blocked or cloudrefit_show_push_modal"/>
                        
                <!-- Urgent Push Button -->
                <button name="action_zatca_sign"
                        string="Push to ZATCA (Urgent Update)"
                        type="object"
                        class="btn-danger"
                        icon="fa-cloud-upload"
                        confirm="An urgent compliance update is available. We strongly recommend updating before pushing. Proceed anyway?"
                        invisible="not is_zatca_push_allowed or move_type not in ('out_invoice', 'out_refund') or not cloudrefit_show_push_modal"/>

                <!-- Sandbox Test Button -->
                <button name="action_push_to_sandbox_zatca"
                        string="Push to ZATCA Sandbox"
                        type="object"
                        class="btn-secondary"
                        icon="fa-flask"
                        invisible="not is_zatca_sandbox_allowed or move_type not in ('out_invoice', 'out_refund') or state != 'posted' or zatca_status in ('reported', 'cleared') or cloudrefit_push_blocked or cloudrefit_show_push_modal"/>
                        
                <!-- Urgent Sandbox Test Button -->
                <button name="action_push_to_sandbox_zatca"
                        string="Push to ZATCA Sandbox (Urgent Update)"
                        type="object"
                        class="btn-outline-danger"
                        icon="fa-flask"
                        confirm="An urgent compliance update is available. We strongly recommend updating before testing. Proceed anyway?"
                        invisible="not is_zatca_sandbox_allowed or move_type not in ('out_invoice', 'out_refund') or state != 'posted' or zatca_status in ('reported', 'cleared') or not cloudrefit_show_push_modal"/>
                
            </xpath>
            
            <!-- Smart Button for Status -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_zatca_sign" type="object" class="oe_stat_button" icon="fa-check-circle" invisible="move_type not in ('out_invoice', 'out_refund') or not is_zatca_push_allowed">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">ZATCA</span>
                        <span class="o_stat_value">
                            <field name="zatca_status" widget="badge" 
                                   decoration-success="zatca_status in ('reported', 'cleared') and zatca_exec_mode == 'live'"
                                   decoration-info="zatca_status in ('reported', 'cleared') and zatca_exec_mode == 'sandbox'"
                                   decoration-danger="zatca_status == 'failed'"/>
                        </span>
                    </div>
                </button>
            </xpath>

            <!-- Status Ribbons and Warning Banners -->
            <xpath expr="//sheet" position="before">
                <!-- Update Banners -->
                <!-- major: dismissible info banner -->
                <div invisible="not cloudrefit_show_banner or cloudrefit_effective_severity != 'major'"
                     class="alert alert-info d-flex align-items-center mb-0">
                    <i class="fa fa-info-circle mr-2"/>
                    <strong class="mr-1">Update Recommended:</strong> <field name="cloudrefit_update_title" readonly="1"/>
                    <button type="object" name="action_dismiss_update" class="btn btn-sm ml-auto text-dark" invisible="not cloudrefit_banner_dismissible">✕</button>
                </div>

                <!-- critical: persistent orange warning -->
                <div invisible="not cloudrefit_show_banner or cloudrefit_effective_severity != 'critical'"
                     class="alert alert-warning mb-0">
                    <i class="fa fa-exclamation-triangle mr-2"/>
                    <strong class="mr-1">Critical Update Available:</strong> <field name="cloudrefit_update_title" readonly="1"/>
                </div>

                <!-- urgent / blocked: persistent red danger -->
                <div invisible="not cloudrefit_show_banner or cloudrefit_effective_severity not in ('urgent', 'blocked')"
                     class="alert alert-danger mb-0">
                    <i class="fa fa-ban mr-2"/>
                    <strong class="mr-1">Urgent Update Required:</strong> <field name="cloudrefit_update_title" readonly="1"/>
                    <span invisible="cloudrefit_effective_severity != 'blocked'" class="ml-1">
                        — ZATCA submissions are disabled until you upgrade.
                    </span>
                </div>
                <div class="alert alert-warning mb-0" role="alert" invisible="not zatca_15_days_warning">
                    <strong><i class="fa fa-clock-o"/> ZATCA Warning:</strong> This invoice is older than 15 days and cannot be pushed to ZATCA Live.
                </div>
                <div class="alert alert-danger mb-0" role="alert" invisible="zatca_status != 'failed'">
                    <strong><i class="fa fa-exclamation-triangle"/> ZATCA Error:</strong>
                    <span class="ml-2"><field name="zatca_error"/></span>
                </div>
                <div class="alert alert-info mb-0 d-flex justify-content-between align-items-center" role="alert" invisible="zatca_job_status not in ('pending', 'processing')">
                    <div>
                        <i class="fa fa-spinner fa-spin"/> ZATCA job is <field name="zatca_job_status"/>...
                        <field name="zatca_pushed_at" widget="zatca_timer" invisible="zatca_job_status not in ('pending', 'processing')"/>
                    </div>
                    <button name="action_zatca_refresh_status" type="object" string="Refresh Status" class="btn btn-sm btn-info" icon="fa-refresh"/>
                </div>
                

                <div class="alert alert-warning mb-0" role="alert" invisible="not zatca_config_warning">
                    <strong><i class="fa fa-cog"/> Configuration Required: </strong>
                    <span class="ml-2"><field name="zatca_config_warning"/></span>
                </div>
                <!-- ZATCA Status Alerts (Replaces Ribbons to prevent hiding the Paid ribbon) -->
                <div class="alert alert-success mb-0 d-flex justify-content-between align-items-center" role="alert" invisible="not (zatca_status == 'reported' and zatca_exec_mode == 'live')">
                    <div><strong><i class="fa fa-check-circle"/> ZATCA LIVE:</strong> Successfully Reported.</div>
                </div>
                <div class="alert alert-success mb-0 d-flex justify-content-between align-items-center" role="alert" invisible="not (zatca_status == 'cleared' and zatca_exec_mode == 'live')">
                    <div><strong><i class="fa fa-check-circle"/> ZATCA LIVE:</strong> Successfully Cleared.</div>
                </div>
                <div class="alert alert-info mb-0 d-flex justify-content-between align-items-center" role="alert" invisible="not (zatca_status == 'reported' and zatca_exec_mode == 'sandbox')">
                    <div><strong><i class="fa fa-info-circle"/> ZATCA SANDBOX:</strong> Successfully Reported.</div>
                </div>
                <div class="alert alert-info mb-0 d-flex justify-content-between align-items-center" role="alert" invisible="not (zatca_status == 'cleared' and zatca_exec_mode == 'sandbox')">
                    <div><strong><i class="fa fa-info-circle"/> ZATCA SANDBOX:</strong> Successfully Cleared.</div>
                </div>
                <div class="alert alert-danger mb-0 d-flex justify-content-between align-items-center" role="alert" invisible="zatca_status != 'failed'">
                    <div><strong><i class="fa fa-exclamation-triangle"/> ZATCA FAILED:</strong> <field name="zatca_error" readonly="1"/></div>
                </div>
            </xpath>

            <!-- Consolidated ZATCA Settings in Other Info -->
            <xpath expr="//page[@name='other_info']" position="inside">
                <group>
                    <group string="ZATCA Compliance" name="zatca_info_group">
                        <field name="zatca_uuid"/>
                        <field name="zatca_invoice_type"/>
                        <field name="zatca_exec_mode"/>
                        <field name="mode_override" readonly="zatca_status in ('reported', 'cleared') and zatca_exec_mode == 'live'"/>
                        <field name="zatca_invoice_type_override" readonly="zatca_status in ('reported', 'cleared') and zatca_exec_mode == 'live'"/>
                        <field name="zatca_hash" invisible="not zatca_hash"/>
                        <field name="zatca_qr_code" widget="image" invisible="not zatca_qr_code" class="mt-2" options="{'size': [150, 150]}"/>
                        <field name="zatca_signed_xml_filename" invisible="1"/>
                        <field name="zatca_signed_xml_file" filename="zatca_signed_xml_filename" widget="binary" invisible="not zatca_signed_xml"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- List View Status Column -->
    <record id="view_invoice_tree_zatca" model="ir.ui.view">
        <field name="name">account.out.invoice.tree.zatca</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="zatca_status" widget="badge"
                       decoration-success="zatca_status in ('reported', 'cleared')"
                       decoration-info="zatca_status == 'signed'"
                       decoration-danger="zatca_status == 'failed'"
                       decoration-muted="zatca_status == 'not_signed'"
                       optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Quick-Push Button in Tree View -->
    <record id="view_invoice_tree_zatca_push" model="ir.ui.view">
        <field name="name">account.out.invoice.tree.zatca.push</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="zatca_show_quick_push" column_invisible="1"/>
                <field name="cloudrefit_push_blocked" column_invisible="1"/>
                <field name="cloudrefit_show_push_modal" column_invisible="1"/>
                <button name="action_zatca_sign_invoice" type="object"
                        string="Push" class="btn btn-sm btn-primary"
                        icon="fa-cloud-upload"
                        invisible="not zatca_show_quick_push or cloudrefit_push_blocked or cloudrefit_show_push_modal"/>
                <button name="action_zatca_sign_invoice" type="object"
                        string="Push (Urgent)" class="btn btn-sm btn-danger"
                        icon="fa-cloud-upload"
                        confirm="An urgent compliance update is available. We strongly recommend updating before pushing. Proceed anyway?"
                        invisible="not zatca_show_quick_push or not cloudrefit_show_push_modal"/>
            </xpath>
        </field>
    </record>

</odoo>
