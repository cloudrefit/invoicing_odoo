<odoo>
    <!-- RTL: Verified for Arabic locale compatibility -->
    <record id="view_partner_form_zatca" model="ir.ui.view">
        <field name="name">res.partner.form.zatca</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="ZATCA Compliance" name="zatca_compliance">
                    <group>
                        <group string="Configuration">
                            <field name="zatca_invoice_type"/>
                            <field name="zatca_vat"/>
                            <field name="zatca_id_type"/>
                            <field name="zatca_id_value"/>
                            <field name="building_no"/>
                            <field name="district"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
