<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- RTL: Verified for Arabic locale compatibility -->
    <record id="res_config_settings_view_form_zatca" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.zatca</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="100"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="CloudRefit ZATCA" string="CloudRefit ZATCA" name="cloudrefit_invoicing" groups="account.group_account_manager">
                    
                    <div class="alert alert-info" role="alert">
                        <i class="fa fa-info-circle mr-2"/>
                        These settings are per-company. Use the company selector above to configure each company separately.
                    </div>

                    <!-- === Hidden Data Fields === -->
                    <field name="gateway_health_status_live" invisible="1"/>
                    <field name="gateway_health_last_check_live" invisible="1"/>
                    <field name="gateway_health_message_live" invisible="1"/>
                    <field name="gateway_health_status_sandbox" invisible="1"/>
                    <field name="gateway_health_last_check_sandbox" invisible="1"/>
                    <field name="gateway_health_message_sandbox" invisible="1"/>
                    <field name="can_enable_live" invisible="1"/>
                    <field name="can_enable_sandbox" invisible="1"/>

                    <!-- === General UI Settings === -->
                    <block id="general_ui_settings" title="General Settings">
                        <setting title="Show Sandbox Settings">
                            <field name="cloudrefit_show_sandbox_settings"/>
                            <div class="text-muted">Display configuration for the ZATCA Sandbox testing environment. Useful for decluttering the settings view once Live.</div>
                        </setting>
                    </block>

                    <!-- === Live Settings === -->
                    <block id="live_settings" title="Live Settings">
                        <setting>
                            <field name="cloudrefit_gateway_url_live" placeholder="https://api.invoicing.cloudrefit.com"/>
                            <div class="text-muted">URL of your CloudRefit Gateway for live/production operations</div>
                        </setting>
                        <setting>
                            <field name="cloudrefit_api_key_live" password="True"/>
                            <div class="text-muted">Your Live API Key (Keep secret)</div>
                        </setting>
                        <setting>
                            <field name="cloudrefit_signing_secret_live" password="True"/>
                            <div class="text-muted">Live signing secret from your CloudRefit dashboard.</div>
                        </setting>
                        <setting>
                            <field name="cloudrefit_unit_id_live"/>
                            <div class="text-muted">Live Technical Unit ID.</div>
                        </setting>
                        <setting>
                            <field name="cloudrefit_business_name_live" readonly="1"/>
                            <div class="text-muted">Business Name auto-populated from gateway.</div>
                        </setting>
                        <setting>
                            <field name="cloudrefit_business_id_live" readonly="1"/>
                            <div class="text-muted">Business ID auto-populated from gateway.</div>
                        </setting>
                        <setting title="Enable Live">
                            <field name="cloudrefit_live_enabled" readonly="not can_enable_live"/>
                            <span class="text-muted">
                                Show the Live ZATCA tab and allow pushing invoices to live ZATCA.
                                <t invisible="can_enable_live">
                                    — Fill in all credentials above and click "Test Connection" first.
                                </t>
                            </span>
                        </setting>
                        <!-- Live Connection Health -->
                        <div class="mt-3">
                            <!-- Connected -->
                            <div class="alert alert-success" invisible="gateway_health_status_live != 'connected'" role="alert" style="margin-bottom: 0;">
                                <i class="fa fa-check-circle mr-2"/>
                                <span>🟢 Connected to Live </span>
                                <span class="ml-2">
                                    <button name="action_test_connection_live" type="object"
                                            string="Test Connection (Live)"
                                            class="btn btn-sm btn-outline-success float-right"/>
                                </span>
                            </div>
                            <!-- Failed -->
                            <div class="alert alert-danger" invisible="gateway_health_status_live != 'failed'" role="alert" style="margin-bottom: 0;">
                                <i class="fa fa-exclamation-circle mr-2"/>
                                <span>🔴 Connection Failed: </span><field name="gateway_health_message_live"/>
                                <span class="ml-2">
                                    <button name="action_test_connection_live" type="object"
                                            string="Test Connection (Live)"
                                            class="btn btn-sm btn-outline-danger float-right"/>
                                </span>
                            </div>
                            <!-- Untested -->
                            <div class="alert alert-secondary" invisible="gateway_health_status_live != 'untested'" role="alert" style="margin-bottom: 0;">
                                <i class="fa fa-circle-o mr-2"/>
                                <span>⚪ Not yet connected — configure credentials and click "Test Connection (Live)"</span>
                                <span class="ml-2">
                                    <button name="action_test_connection_live" type="object"
                                            string="Test Connection (Live)"
                                            class="btn btn-sm btn-outline-secondary float-right"/>
                                </span>
                            </div>
                            <small class="text-muted">Last checked: <field name="gateway_health_last_check_live"/></small>
                        </div>
                    </block>

                    <!-- === Sandbox Settings === -->
                    <block id="sandbox_settings" title="Sandbox Settings" invisible="not cloudrefit_show_sandbox_settings">
                        <setting>
                            <field name="cloudrefit_gateway_url_sandbox" placeholder="https://api.invoicing.cloudrefit.com"/>
                            <div class="text-muted">URL of your CloudRefit Gateway for sandbox/testing operations</div>
                        </setting>
                        <setting>
                            <field name="cloudrefit_api_key_sandbox" password="True"/>
                            <div class="text-muted">Sandbox API Key for testing.</div>
                        </setting>
                        <setting>
                            <field name="cloudrefit_signing_secret_sandbox" password="True"/>
                            <div class="text-muted">Sandbox signing secret from your CloudRefit dashboard.</div>
                        </setting>
                        <setting>
                            <field name="cloudrefit_unit_id_sandbox"/>
                            <div class="text-muted">Sandbox Technical Unit ID for testing.</div>
                        </setting>
                        <setting>
                            <field name="cloudrefit_business_name_sandbox" readonly="1"/>
                            <div class="text-muted">Business Name auto-populated from gateway.</div>
                        </setting>
                        <setting>
                            <field name="cloudrefit_business_id_sandbox" readonly="1"/>
                            <div class="text-muted">Business ID auto-populated from gateway.</div>
                        </setting>
                        <setting title="Enable Sandbox">
                            <field name="cloudrefit_sandbox_enabled" readonly="not can_enable_sandbox"/>
                            <span class="text-muted">
                                Show the "Test in Sandbox" button on invoices.
                                <t invisible="can_enable_sandbox">
                                    — Fill in all credentials above and click "Test Connection" first.
                                </t>
                            </span>
                        </setting>
                        <!-- Sandbox Connection Health -->
                        <div class="mt-3">
                            <!-- Connected -->
                            <div class="alert alert-success" invisible="gateway_health_status_sandbox != 'connected'" role="alert" style="margin-bottom: 0;">
                                <i class="fa fa-check-circle mr-2"/>
                                <span>🟢 Connected to Sandbox </span>
                                <span class="ml-2">
                                    <button name="action_test_connection_sandbox" type="object"
                                            string="Test Connection (Sandbox)"
                                            class="btn btn-sm btn-outline-success float-right"/>
                                </span>
                            </div>
                            <!-- Failed -->
                            <div class="alert alert-danger" invisible="gateway_health_status_sandbox != 'failed'" role="alert" style="margin-bottom: 0;">
                                <i class="fa fa-exclamation-circle mr-2"/>
                                <span>🔴 Connection Failed: </span><field name="gateway_health_message_sandbox"/>
                                <span class="ml-2">
                                    <button name="action_test_connection_sandbox" type="object"
                                            string="Test Connection (Sandbox)"
                                            class="btn btn-sm btn-outline-danger float-right"/>
                                </span>
                            </div>
                            <!-- Untested -->
                            <div class="alert alert-secondary" invisible="gateway_health_status_sandbox != 'untested'" role="alert" style="margin-bottom: 0;">
                                <i class="fa fa-circle-o mr-2"/>
                                <span>⚪ Not yet connected — configure credentials and click "Test Connection (Sandbox)"</span>
                                <span class="ml-2">
                                    <button name="action_test_connection_sandbox" type="object"
                                            string="Test Connection (Sandbox)"
                                            class="btn btn-sm btn-outline-secondary float-right"/>
                                </span>
                            </div>
                            <small class="text-muted">Last checked: <field name="gateway_health_last_check_sandbox"/></small>
                        </div>
                    </block>

                    <!-- === Invoice Behaviour === -->
                    <block id="invoice_behaviour" title="Invoice Behaviour">
                        <setting>
                            <field name="cloudrefit_default_invoice_type"/>
                            <div class="text-muted">Select the default ZATCA invoice type for this company</div>
                        </setting>
                        <setting title="Environment Mode">
                            <field name="cloudrefit_mode"/>
                            <div class="text-muted">Target ZATCA environment for this company</div>
                        </setting>
                        <setting title="Download Signed XMLs">
                            <field name="cloudrefit_zatca_download_xml"/>
                            <div class="text-muted">Download Signed XMLs (May incur additional fees — turn off if CloudRefit hosts your data)</div>
                        </setting>

                    </block>

                    <!-- === About Plugin === -->
                    <div class="row mt-3" name="about_plugin">
                        <div class="col-12">
                            <div class="oe_blue_box" style="padding: 16px;">
                                <h3>About CloudRefit ZATCA Gateway</h3>
                                <field name="cloudrefit_update_severity" invisible="1"/>
                                <field name="cloudrefit_changelog_url" invisible="1"/>
                                
                                <table class="table table-sm table-borderless" style="margin-bottom: 0;">
                                    <tr>
                                        <td style="width: 150px;"><strong>Installed Version:</strong></td>
                                        <td><field name="cloudrefit_plugin_version"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Latest Version:</strong></td>
                                        <td>
                                            <field name="cloudrefit_latest_version"/>
                                            <span class="badge badge-info ml-2" invisible="cloudrefit_update_severity != 'info'">Update Available</span>
                                            <span class="badge badge-warning ml-2" invisible="cloudrefit_update_severity not in ('minor', 'major')">Update Recommended</span>
                                            <span class="badge badge-danger ml-2" invisible="cloudrefit_update_severity not in ('critical', 'urgent', 'blocked')">Critical Update Required</span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><strong>Last Checked:</strong></td>
                                        <td>
                                            <field name="cloudrefit_update_checked_at"/>
                                            <button name="action_check_now" type="object" string="Check Now" class="btn btn-link btn-sm ml-2 p-0" icon="fa-refresh"/>
                                        </td>
                                    </tr>
                                </table>

                                <!-- Update Message Block -->
                                <div invisible="cloudrefit_update_severity == 'none'" class="mt-3 p-3 bg-light rounded border">
                                    <h4 class="mb-1"><field name="cloudrefit_update_title" readonly="1" force_save="1"/></h4>
                                    <p class="mb-2 text-muted"><field name="cloudrefit_update_message" readonly="1" force_save="1"/></p>
                                    <div>
                                        <field name="cloudrefit_changelog_url" widget="url" text="View Changelog" invisible="not cloudrefit_changelog_url" class="btn btn-sm btn-outline-primary oe_inline"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </app>
            </xpath>
        </field>
    </record>

    <!-- Action to open CloudRefit Settings from Invoicing App -->
    <record id="action_cloudrefit_zatca_config_settings" model="ir.actions.act_window">
        <field name="name">CloudRefit ZATCA Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module' : 'cloudrefit_invoicing', 'bin_size': False}</field>
    </record>

    <!-- Menu Item in Invoicing > Configuration -->
    <menuitem id="menu_cloudrefit_zatca_settings"
        name="CloudRefit ZATCA Settings"
        parent="account.menu_finance_configuration"
        action="action_cloudrefit_zatca_config_settings"
        sequence="105"/>

</odoo>
