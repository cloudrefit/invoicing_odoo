<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="payment_error" name="CloudRefit Payment Error">
        <html>
            <head>
                <title t-esc="title"/>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
                <style>
                    body {
                        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
                        display: flex;
                        justify-content: center;
                        align-items: center;
                        min-height: 100vh;
                        margin: 0;
                        background: #f5f5f5;
                        color: #333;
                    }
                    .error-container {
                        text-align: center;
                        padding: 40px;
                        background: white;
                        border-radius: 12px;
                        box-shadow: 0 2px 12px rgba(0,0,0,0.1);
                        max-width: 480px;
                        margin: 20px;
                    }
                    .error-icon {
                        font-size: 64px;
                        margin-bottom: 16px;
                    }
                    h1 {
                        font-size: 24px;
                        margin: 0 0 12px 0;
                        color: #e74c3c;
                    }
                    p {
                        font-size: 16px;
                        line-height: 1.5;
                        margin: 0 0 24px 0;
                        color: #666;
                    }
                </style>
            </head>
            <body>
                <div class="error-container">
                    <div class="error-icon">⚠️</div>
                    <h1><t t-esc="title"/></h1>
                    <p><t t-esc="message"/></p>
                </div>
            </body>
        </html>
    </template>
</odoo>
