<odoo>
    <!-- RTL: Verified for Arabic locale compatibility -->
    <record id="view_cloudrefit_zatca_sandbox_test_form" model="ir.ui.view">
        <field name="name">cloudrefit.zatca.sandbox.test.form</field>
        <field name="model">cloudrefit.zatca.sandbox.test</field>
        <field name="arch" type="xml">
            <form>
                <!-- Step 1: Select Invoice -->
                <group string="Select Invoice" invisible="state != 'select'">
                    <field name="invoice_id" required="1"
                           domain="[('state','in',['posted','draft']), ('move_type','in',['out_invoice','out_refund'])]"
                           options="{'no_create': True}"/>
                    <group>
                        <button name="action_test_sandbox"
                                string="Test with ZATCA Sandbox" type="object"
                                class="btn-primary" invisible="not invoice_id"/>
                    </group>
                </group>

                <!-- Step 2: Testing -->
                <group string="Testing..." invisible="state != 'testing'">
                    <div class="text-center mt-4 mb-4">
                        <i class="fa fa-spinner fa-spin fa-3x" title="Loading..." aria-label="Loading"/>
                        <h4>Submitting to ZATCA Sandbox...</h4>
                        <p class="text-muted">Please wait while the invoice is being tested.</p>
                    </div>
                </group>

                <!-- Step 3: Results -->
                <group string="Sandbox Test Results" invisible="state != 'done'">
                    <field name="zatca_status" widget="badge"
                           decoration-success="zatca_status in ('reported', 'cleared')"
                           decoration-danger="zatca_status == 'failed'"/>
                    <group invisible="zatca_status == 'failed'">
                        <field name="zatca_hash" widget="CopyClipboardChar"/>
                        <field name="zatca_qr_code" widget="image" options="{'size': [200, 200]}"
                               invisible="not zatca_qr_code"/>
                    </group>
                    <group invisible="zatca_status != 'failed'">
                        <div class="alert alert-danger" role="alert">
                            <field name="zatca_error" widget="CopyClipboardChar"/>
                        </div>
                    </group>
                    <footer>
                        <button name="action_print_sandbox_invoice" string="Print Sandbox Invoice"
                                type="object" class="btn-primary" invisible="not zatca_qr_code"/>
                        <button string="Close" class="btn-secondary" special="cancel"/>
                    </footer>
                </group>
            </form>
        </field>
    </record>

    <!-- Action to open the wizard -->
    <record id="action_cloudrefit_zatca_sandbox_test" model="ir.actions.act_window">
        <field name="name">ZATCA Sandbox Test</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">cloudrefit.zatca.sandbox.test</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
